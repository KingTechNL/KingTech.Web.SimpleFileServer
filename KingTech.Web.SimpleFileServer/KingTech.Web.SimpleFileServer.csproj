<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>b4bb359f-9369-4870-b109-8bbd59429c8e</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
	<DockerfileFile>../Dockerfile</DockerfileFile>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
	<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

	<ItemGroup>
    <PackageReference Include="McMaster.NETCore.Plugins" Version="1.4.0" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.20.1" />
    <PackageReference Include="Seq.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.6" />

    <PackageReference Include="KingTech.Web.SimpleFileServer.Abstract" Version="0.1.0-onedrive-source.48" />
  </ItemGroup>

	<!--	
	<ItemGroup>
		<ProjectReference Include="..\KingTech.Web.SimpleFileServer.Abstract.NuGet\KingTech.Web.SimpleFileServer.Abstract.NuGet.csproj" />
	</ItemGroup>
	-->

	<!-- Add docker properties for testing from Visual Studio -->
	<PropertyGroup>
		<!--<DockerfileRunArguments>-v "C:/dev/_data/SimpleFileServer/Files:/files:rw" -v "C:/dev/_data/SimpleFileServer/Plugins/:/plugins:rw"</DockerfileRunArguments>-->
		<DockerfileRunArguments>-v "C:/dev/_data/SimpleFileServer/Files:/files:rw" -v "$(TargetDir)/Plugins/:/plugins:rw"</DockerfileRunArguments>
	</PropertyGroup>

	<!-- Share internal methods/classes with unittest projects -->
	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>$(AssemblyName).UnitTests</_Parameter1>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>KingTech.Web.SimpleFileServer.UnitTests</_Parameter1>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
			<_Parameter1>KingTech.Web.SimpleFileServer.UnitTests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

</Project>
