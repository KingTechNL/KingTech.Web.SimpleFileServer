{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Seq": {
    "Enabled": true,
    "ServerUrl": "http://localhost:5341",
    /*"ApiKey": "1234567890",*/
    "MinimumLevel": "Trace",
    "LevelOverride": {
      "Microsoft": "Warning"
    }
  },
  "AllowedHosts": "*",
  /*Real SFS Settings*/
  "GeneralSettings": {
    "PrefixSourceName" :  true,
  },
  "FileSystemFileSourceSettings": {
    "Enabled": true,
    "Name" :  "local",
    "IsReadOnly": false,
    "BaseDirectory": "/files"
  },
  "ImageResizeTransformerSettings": {
    "ThumbnailWidth": 100,
    "ThumbnailHeight": 100,
    "KeepThumbnailAspectRatio": true
  }
}
